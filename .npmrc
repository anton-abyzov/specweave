# Supply-chain guard (2026-09): never run dependency install scripts inside this repo.
# Rebuild the few packages that legitimately need them with `npm run setup`.
# This file is never published (npm always excludes .npmrc from tarballs), so
# end users installing `specweave` still get the package's own preinstall hook.
#
# CAVEAT — this also disables OUR OWN lifecycle hooks, `prepublishOnly` included.
# `ignore-scripts` is not scoped to dependencies, so a bare `npm publish` here
# runs no rebuild and no version check, and would happily upload a tarball with
# no dist/ in it. Deleting this file would not help: the maintainer's global
# ~/.npmrc sets the same flag. So the publish path never relies on the hook:
#   - by hand:  `npm run release`      (passes --ignore-scripts=false)
#   - in CI:    .github/workflows/release.yml runs build / validate:versions /
#               release:preflight as explicit steps before `npm publish`
# `npm run release:preflight` is the backstop — it inspects the tarball npm
# would actually upload and refuses an unbuilt or stale one.
ignore-scripts=true
fund=false
audit=false
