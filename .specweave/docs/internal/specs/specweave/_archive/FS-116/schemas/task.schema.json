{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://livingspec.io/schemas/v1/task.schema.json",
  "title": "LivingSpec Task Schema",
  "description": "JSON Schema for Task entries with E-suffix support for external items",
  "type": "object",
  "required": ["id", "title", "user_story", "status"],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^T-\\d{3,}E?$",
      "description": "Task ID. Format: T-XXX (internal) or T-XXXE (external)"
    },
    "title": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200,
      "description": "Task title"
    },
    "user_story": {
      "type": "string",
      "pattern": "^US-\\d{3,}E?$",
      "description": "Parent User Story ID"
    },
    "satisfies_acs": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^AC-US\\d+E?-\\d{2}E?$"
      },
      "description": "List of Acceptance Criteria IDs this task satisfies"
    },
    "status": {
      "type": "string",
      "enum": ["pending", "in-progress", "completed", "blocked"],
      "description": "Task status"
    },
    "origin": {
      "type": "string",
      "enum": ["internal", "external"],
      "description": "Origin of this task"
    },
    "source": {
      "type": "string",
      "enum": ["github", "jira", "ado"],
      "description": "External tool source"
    },
    "external_id": {
      "type": "string",
      "description": "ID in the external tool"
    },
    "external_url": {
      "type": "string",
      "format": "uri",
      "description": "URL to the item in external tool"
    }
  },
  "if": {
    "properties": {
      "id": { "pattern": "E$" }
    }
  },
  "then": {
    "required": ["origin", "source"],
    "properties": {
      "origin": { "const": "external" }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "user_story": { "pattern": "E$" }
        },
        "required": ["user_story"]
      },
      "then": {
        "properties": {
          "id": { "pattern": "E$" }
        }
      }
    }
  ]
}
