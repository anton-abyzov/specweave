{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "SpecWeave Configuration",
  "description": "Schema for .specweave/config.yaml configuration file",
  "type": "object",
  "properties": {
    "plugins": {
      "type": "object",
      "description": "Plugin configuration",
      "properties": {
        "enabled": {
          "type": "array",
          "description": "List of enabled plugin names",
          "items": {
            "type": "string",
            "pattern": "^specweave-[a-z0-9-]+$"
          },
          "uniqueItems": true,
          "examples": [
            ["specweave-github", "specweave-frontend-stack"]
          ]
        },
        "settings": {
          "type": "object",
          "description": "Plugin-specific settings",
          "patternProperties": {
            "^specweave-[a-z0-9-]+$": {
              "type": "object",
              "description": "Settings for a specific plugin"
            }
          },
          "additionalProperties": false
        }
      },
      "required": ["enabled"],
      "additionalProperties": false
    },
    "project": {
      "type": "object",
      "description": "Project metadata",
      "properties": {
        "name": {
          "type": "string",
          "description": "Project name",
          "minLength": 1,
          "maxLength": 256
        },
        "version": {
          "type": "string",
          "description": "Project version (semver)",
          "pattern": "^\\d+\\.\\d+\\.\\d+(-[a-z0-9.-]+)?(\\+[a-z0-9.-]+)?$"
        },
        "description": {
          "type": "string",
          "description": "Project description",
          "maxLength": 1024
        }
      },
      "additionalProperties": true
    },
    "adapters": {
      "type": "object",
      "description": "Adapter configuration",
      "properties": {
        "default": {
          "type": "string",
          "description": "Default adapter to use",
          "enum": ["claude", "cursor", "copilot", "generic"]
        }
      },
      "additionalProperties": true
    },
    "language": {
      "type": "string",
      "description": "Primary language for generated content and CLI",
      "enum": ["en", "ru", "es", "zh", "de", "fr", "ja", "ko", "pt"],
      "default": "en"
    },
    "limits": {
      "type": "object",
      "description": "Advisory WIP limit (2.0). No hard cap: exceeding it prints one info note and never blocks.",
      "properties": {
        "activeIncrements": {
          "type": "number",
          "description": "Recommended maximum active increments. 0 disables the note.",
          "minimum": 0,
          "default": 3
        }
      },
      "additionalProperties": false
    },
    "hooks": {
      "type": "object",
      "description": "Hook configuration for lifecycle automation (Claude Code only)",
      "properties": {
        "post_task_completion": {
          "type": "object",
          "description": "Post-task completion hook settings",
          "properties": {
            "sync_tasks_md": {
              "type": "boolean",
              "description": "Update tasks.md with completion status",
              "default": true
            },
            "external_tracker_sync": {
              "type": "boolean",
              "description": "Sync to external tracker (GitHub Issues, Jira, ADO) on each task completion. Disable to reduce API calls; sync happens on increment open/close instead.",
              "default": false
            }
          },
          "additionalProperties": false
        },
        "post_increment_planning": {
          "type": "object",
          "description": "Post-increment planning hook settings",
          "properties": {
            "auto_create_github_issue": {
              "type": "boolean",
              "description": "Automatically create GitHub issue after increment planning",
              "default": true
            },
            "sync_living_docs": {
              "type": "boolean",
              "description": "Sync living docs after increment planning (before external issue creation)",
              "default": true
            }
          },
          "additionalProperties": false
        },
        "post_increment_done": {
          "type": "object",
          "description": "Post-increment done hook settings (MANDATORY for GitHub Project sync)",
          "properties": {
            "sync_living_docs": {
              "type": "boolean",
              "description": "Sync specs to living docs when increment closes",
              "default": true
            },
            "sync_to_github_project": {
              "type": "boolean",
              "description": "MANDATORY: Automatically sync living docs spec to GitHub Project when increment closes (ensures source of truth integrity)",
              "default": true
            },
            "close_github_issue": {
              "type": "boolean",
              "description": "Automatically close GitHub issue when increment closes",
              "default": true
            },
            "update_living_docs_first": {
              "type": "boolean",
              "description": "Ensure living docs are synced before GitHub Project sync",
              "default": true
            }
          },
          "additionalProperties": false,
          "required": ["sync_to_github_project"]
        }
      },
      "additionalProperties": false
    },
    "statusLine": {
      "type": "object",
      "description": "Status line configuration (simplified). Shows: [increment-name] ████░░░░ X/Y tasks (Z open)",
      "properties": {
        "enabled": {
          "type": "boolean",
          "description": "Enable status line rendering",
          "default": true
        },
        "maxCacheAge": {
          "type": "number",
          "description": "Maximum age of cache before showing stale warning (milliseconds)",
          "default": 30000,
          "minimum": 5000,
          "maximum": 120000
        },
        "progressBarWidth": {
          "type": "number",
          "description": "Width of progress bar in characters",
          "default": 8,
          "minimum": 4,
          "maximum": 20
        },
        "maxNameLength": {
          "type": "number",
          "description": "Maximum length for increment name display",
          "default": 30,
          "minimum": 10,
          "maximum": 50
        }
      },
      "additionalProperties": false
    },
    "translation": {
      "type": "object",
      "description": "Translation settings for multilingual support",
      "properties": {
        "enabled": {
          "type": "boolean",
          "description": "Enable/disable translation system entirely",
          "default": true
        },
        "method": {
          "type": "string",
          "description": "Translation method (always in-session for zero cost)",
          "enum": ["in-session"],
          "default": "in-session"
        },
        "autoTranslateInternalDocs": {
          "type": "boolean",
          "description": "Automatically translate increment files (spec.md, plan.md, tasks.md) and living docs specs to English after increment planning (recommended: true)",
          "default": true
        },
        "autoTranslateLivingDocs": {
          "type": "boolean",
          "description": "Automatically translate living docs to English after task completion (ADRs, HLDs, etc.)",
          "default": true
        },
        "keepFrameworkTerms": {
          "type": "boolean",
          "description": "Keep framework terms (Increment, Living Docs, SpecWeave, ADR, RFC) in English",
          "default": true
        },
        "keepTechnicalTerms": {
          "type": "boolean",
          "description": "Keep technical terms (Git, Docker, Kubernetes, npm, TypeScript) in English",
          "default": true
        },
        "translateCodeComments": {
          "type": "boolean",
          "description": "Translate comments in generated code",
          "default": true
        },
        "translateVariableNames": {
          "type": "boolean",
          "description": "Translate variable/function names (NOT RECOMMENDED)",
          "default": false
        },
        "filesAlwaysInEnglish": {
          "type": "array",
          "description": "File patterns that must always be in English (glob patterns)",
          "items": {
            "type": "string"
          },
          "default": [
            "spec.md",
            "plan.md",
            "tasks.md",
            "tests.md",
            "docs/internal/**/*.md"
          ]
        },
        "translationModel": {
          "type": "string",
          "description": "LLM model to use for translation",
          "enum": ["haiku", "sonnet", "opus"],
          "default": "haiku"
        }
      },
      "additionalProperties": false
    },
    "multiProject": {
      "type": "object",
      "description": "DEPRECATED: Use workspace instead. Multi-project configuration for internal docs organization.",
      "properties": {
        "enabled": {
          "type": "boolean",
          "description": "Enable multi-project mode (false = single project using projects/default/)",
          "default": false
        },
        "projects": {
          "type": "array",
          "description": "Available projects",
          "items": {
            "type": "object",
            "description": "Project configuration",
            "properties": {
              "id": {
                "type": "string",
                "description": "Unique project identifier (kebab-case)",
                "pattern": "^[a-z0-9-]+$",
                "minLength": 1,
                "maxLength": 64
              },
              "name": {
                "type": "string",
                "description": "Project display name",
                "minLength": 1,
                "maxLength": 128
              },
              "description": {
                "type": "string",
                "description": "Project description",
                "maxLength": 512
              },
              "techStack": {
                "type": "array",
                "description": "Technologies used in this project",
                "items": {
                  "type": "string"
                },
                "default": []
              },
              "team": {
                "type": "string",
                "description": "Team or organization name",
                "minLength": 1,
                "maxLength": 128
              },
              "contacts": {
                "type": "object",
                "description": "Project contacts",
                "properties": {
                  "lead": {
                    "type": "string",
                    "description": "Tech lead email",
                    "format": "email"
                  },
                  "pm": {
                    "type": "string",
                    "description": "Product manager email",
                    "format": "email"
                  }
                },
                "additionalProperties": false
              },
              "syncProfiles": {
                "type": "array",
                "description": "Linked sync profiles from sync.profiles (references profile IDs)",
                "items": {
                  "type": "string"
                },
                "default": []
              }
            },
            "required": ["id", "name", "description", "team"],
            "additionalProperties": false
          },
          "minItems": 1
        }
      },
      "additionalProperties": false
    },
    "brownfield": {
      "type": "object",
      "description": "Brownfield documentation import tracking",
      "properties": {
        "importHistory": {
          "type": "array",
          "description": "History of all brownfield imports",
          "items": {
            "type": "object",
            "description": "Single import record",
            "properties": {
              "source": {
                "type": "string",
                "description": "Source type",
                "enum": ["notion", "confluence", "wiki", "custom"]
              },
              "workspace": {
                "type": "string",
                "description": "Source workspace/space name"
              },
              "importedAt": {
                "type": "string",
                "description": "ISO 8601 timestamp of import",
                "format": "date-time"
              },
              "project": {
                "type": "string",
                "description": "Target project ID",
                "pattern": "^[a-z0-9-]+$"
              },
              "filesImported": {
                "type": "number",
                "description": "Total number of files imported",
                "minimum": 0
              },
              "destination": {
                "type": "string",
                "description": "Destination path"
              }
            },
            "required": ["source", "importedAt", "project", "filesImported", "destination"],
            "additionalProperties": false
          },
          "default": []
        }
      },
      "additionalProperties": false
    },
    "documentation": {
      "type": "object",
      "description": "Documentation configuration — directories and preview",
      "properties": {
        "directories": {
          "type": "array",
          "description": "Directories to search for documentation (relative to project root)",
          "items": { "type": "string" },
          "default": [".specweave/docs"]
        },
        "preview": {
          "type": "object",
          "description": "Local documentation preview settings",
          "properties": {
            "enabled": {
              "type": "boolean",
              "description": "Enable documentation preview feature",
              "default": true
            },
            "autoInstall": {
              "type": "boolean",
              "description": "Automatically install Docusaurus dependencies (lazy install on first use recommended)",
              "default": false
            },
            "port": {
              "type": "number",
              "description": "Default port for internal docs preview (3015 for internal, 3016 for public)",
              "minimum": 1024,
              "maximum": 65535,
              "default": 3015
            },
            "openBrowser": {
              "type": "boolean",
              "description": "Automatically open browser when server starts",
              "default": true
            },
            "theme": {
              "type": "string",
              "description": "Documentation theme",
              "enum": ["default", "classic", "dark"],
              "default": "default"
            },
            "excludeFolders": {
              "type": "array",
              "description": "Folders to exclude from documentation",
              "items": {
                "type": "string"
              },
              "default": ["legacy", "node_modules"]
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "reflection": {
      "type": "object",
      "description": "AI Self-Reflection System configuration (v0.12.0+)",
      "properties": {
        "enabled": {
          "type": "boolean",
          "description": "Enable/disable reflection system entirely",
          "default": true
        },
        "mode": {
          "type": "string",
          "description": "Reflection execution mode",
          "enum": ["auto", "manual", "disabled"],
          "default": "auto"
        },
        "depth": {
          "type": "string",
          "description": "Analysis depth level",
          "enum": ["quick", "standard", "deep"],
          "default": "standard"
        },
        "model": {
          "type": "string",
          "description": "AI model for reflection analysis",
          "enum": ["haiku", "sonnet", "opus"],
          "default": "haiku"
        },
        "categories": {
          "type": "object",
          "description": "Enable/disable specific analysis categories",
          "properties": {
            "security": {
              "type": "boolean",
              "description": "Security vulnerability detection (OWASP Top 10)",
              "default": true
            },
            "quality": {
              "type": "boolean",
              "description": "Code quality and best practices analysis",
              "default": true
            },
            "testing": {
              "type": "boolean",
              "description": "Test coverage and quality analysis",
              "default": true
            },
            "performance": {
              "type": "boolean",
              "description": "Performance issue detection",
              "default": true
            },
            "technicalDebt": {
              "type": "boolean",
              "description": "Technical debt tracking",
              "default": true
            }
          },
          "additionalProperties": false
        },
        "criticalThreshold": {
          "type": "string",
          "description": "Minimum severity to show terminal warnings",
          "enum": ["CRITICAL", "HIGH", "MEDIUM", "LOW"],
          "default": "MEDIUM"
        },
        "storeReflections": {
          "type": "boolean",
          "description": "Store reflections to log files",
          "default": true
        },
        "autoCreateFollowUpTasks": {
          "type": "boolean",
          "description": "Automatically create tasks for critical issues",
          "default": false
        },
        "soundNotifications": {
          "type": "boolean",
          "description": "Play sound for critical issues (optional)",
          "default": false
        }
      },
      "additionalProperties": false
    },
    "externalModels": {
      "type": "object",
      "description": "External model API consent configuration. Controls user consent for paid API calls (Anthropic, OpenAI, Azure, etc.)",
      "properties": {
        "consent": {
          "type": "string",
          "description": "Consent mode: ask (prompt user before external API calls), always-allow (skip consent), never (block all external APIs, use fallbacks)",
          "enum": ["ask", "always-allow", "never"],
          "default": "ask"
        },
        "allowedProviders": {
          "type": "array",
          "description": "Providers with standing consent (skip future prompts)",
          "items": {
            "type": "string",
            "enum": ["anthropic", "openai", "azure-openai", "bedrock", "vertex-ai"]
          },
          "uniqueItems": true,
          "default": []
        }
      },
      "additionalProperties": false
    },
    "tasks": {
      "type": "object",
      "description": "Task-ledger settings (2.0)",
      "properties": {
        "leaseHours": {
          "type": "number",
          "minimum": 0,
          "default": 2,
          "description": "Hours before an unfinished task claim goes stale and may be taken over"
        }
      }
    },
    "testing": {
      "type": "object",
      "description": "Testing configuration including TDD mode, coverage targets, and browser automation",
      "properties": {
        "defaultTestMode": {
          "type": "string",
          "description": "Default test mode for new increments",
          "enum": ["TDD", "test-first", "test-after"],
          "default": "test-after"
        },
        "defaultCoverageTarget": {
          "type": "number",
          "description": "Default code coverage target percentage",
          "minimum": 0,
          "maximum": 100,
          "default": 80
        },
        "coverageTargets": {
          "type": "object",
          "description": "Per-level coverage targets",
          "properties": {
            "unit": {
              "type": "number",
              "description": "Unit test line coverage target (Istanbul/c8 percentage)",
              "minimum": 0,
              "maximum": 100,
              "default": 80
            },
            "integration": {
              "type": "number",
              "description": "Integration test line coverage target (Istanbul/c8 percentage)",
              "minimum": 0,
              "maximum": 100,
              "default": 70
            },
            "e2e": {
              "type": "number",
              "description": "E2E test pass-rate target (percentage of written Playwright tests that must pass, not line coverage)",
              "minimum": 0,
              "maximum": 100,
              "default": 100
            }
          },
          "additionalProperties": false
        },
        "tddEnforcement": {
          "type": "string",
          "description": "TDD enforcement level: strict blocks GREEN without RED, warn shows warning, off disables",
          "enum": ["strict", "warn", "off"],
          "default": "warn"
        },
        "playwright": {
          "type": "object",
          "description": "Playwright browser automation configuration for dual-mode (CLI vs MCP)",
          "properties": {
            "preferCli": {
              "type": "boolean",
              "description": "Prefer @playwright/cli over MCP plugin for automation tasks (98% token reduction). Set false to always use MCP.",
              "default": true
            },
            "cliFlags": {
              "type": "array",
              "description": "Additional flags to pass to playwright-cli commands",
              "items": {
                "type": "string"
              }
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "sync": { "$ref": "./sync.schema.json" },
    "livingDocs": {
      "type": "object",
      "description": "Living documentation sync configuration (v0.18.0+)",
      "properties": {
        "intelligent": {
          "type": "object",
          "description": "Intelligent living docs sync - automatically classify and distribute spec content",
          "properties": {
            "enabled": {
              "type": "boolean",
              "description": "Enable intelligent sync mode (parse, classify, distribute). If false, uses simple copy mode.",
              "default": false
            },
            "splitByCategory": {
              "type": "boolean",
              "description": "Split spec into separate files by category (User Stories, Architecture, Operations, etc.)",
              "default": true
            },
            "generateCrossLinks": {
              "type": "boolean",
              "description": "Generate cross-references between related documents for traceability",
              "default": true
            },
            "preserveOriginal": {
              "type": "boolean",
              "description": "Keep original monolithic spec.md in archive folder for reference",
              "default": true
            },
            "classificationConfidenceThreshold": {
              "type": "number",
              "description": "Minimum confidence (0.0-1.0) for automatic classification. Sections below threshold go to Unknown category.",
              "minimum": 0,
              "maximum": 1,
              "default": 0.6
            },
            "fallbackProject": {
              "type": "string",
              "description": "Default project ID when project cannot be detected from increment name/metadata",
              "default": "default",
              "minLength": 1,
              "maxLength": 64,
              "pattern": "^[a-z0-9-]+$"
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "workspace": { "$ref": "./workspace.schema.json" },
    "projectMappings": {
      "type": "object",
      "description": "DEPRECATED: Use workspace.repos[].sync instead. Cross-project targeting (v0.33.0+).",
      "patternProperties": {
        "^[a-z0-9-]+$": {
          "type": "object",
          "description": "External tool mappings for a project",
          "properties": {
            "github": {
              "type": "object",
              "description": "GitHub repository mapping",
              "properties": {
                "owner": {
                  "type": "string",
                  "description": "GitHub owner (org or user)",
                  "minLength": 1
                },
                "repo": {
                  "type": "string",
                  "description": "GitHub repository name",
                  "minLength": 1
                }
              },
              "required": ["owner", "repo"],
              "additionalProperties": false
            },
            "jira": {
              "type": "object",
              "description": "JIRA project mapping",
              "properties": {
                "project": {
                  "type": "string",
                  "description": "JIRA project key (e.g., 'FE', 'BE', 'SECURITY')",
                  "minLength": 1
                },
                "board": {
                  "type": "string",
                  "description": "JIRA board name (for 2-level)",
                  "minLength": 1
                }
              },
              "required": ["project"],
              "additionalProperties": false
            },
            "ado": {
              "type": "object",
              "description": "Azure DevOps project mapping",
              "properties": {
                "project": {
                  "type": "string",
                  "description": "ADO project name",
                  "minLength": 1
                },
                "areaPath": {
                  "type": "string",
                  "description": "ADO area path (e.g., 'infrastructure/security')",
                  "minLength": 1
                }
              },
              "required": ["project"],
              "additionalProperties": false
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "specs": {
      "type": "object",
      "description": "Spec identifier and sync configuration for flexible multi-project architecture (v0.16.0+)",
      "properties": {
        "identifierStrategy": {
          "type": "string",
          "description": "Default identifier strategy for new specs: auto (detect from context), external (JIRA/ADO/GitHub), custom (user-defined), title-slug (from spec title), sequential (001, 002, ...)",
          "enum": ["auto", "external", "custom", "title-slug", "sequential"],
          "default": "auto"
        },
        "preferTitleSlug": {
          "type": "boolean",
          "description": "Prefer title-based slugs over sequential numbers when no external ID exists",
          "default": true
        },
        "minSlugLength": {
          "type": "number",
          "description": "Minimum length for title slugs to be considered valid",
          "minimum": 3,
          "maximum": 20,
          "default": 5
        },
        "projects": {
          "type": "object",
          "description": "Project-specific spec configurations for multi-project sync (backend, frontend, mobile, infra, _parent, etc.)",
          "patternProperties": {
            "^[a-z0-9-_]+$": {
              "type": "object",
              "description": "Project configuration for spec sync",
              "properties": {
                "id": {
                  "type": "string",
                  "description": "Unique project identifier (must match PROJECT_CODES in spec-identifier.ts: backend, frontend, mobile, infra, _parent, default)",
                  "pattern": "^[a-z0-9-_]+$",
                  "minLength": 1,
                  "maxLength": 64
                },
                "displayName": {
                  "type": "string",
                  "description": "Human-readable project name",
                  "minLength": 1,
                  "maxLength": 128
                },
                "description": {
                  "type": "string",
                  "description": "Project description",
                  "maxLength": 512
                },
                "github": {
                  "type": ["object", "null"],
                  "description": "GitHub repository configuration (null = no sync, e.g., _parent project)",
                  "properties": {
                    "owner": {
                      "type": "string",
                      "description": "GitHub repository owner (organization or user)",
                      "minLength": 1,
                      "maxLength": 128
                    },
                    "repo": {
                      "type": "string",
                      "description": "GitHub repository name",
                      "minLength": 1,
                      "maxLength": 128
                    }
                  },
                  "required": ["owner", "repo"],
                  "additionalProperties": false
                },
                "defaultLabels": {
                  "type": "array",
                  "description": "Default labels for GitHub issues created from specs in this project",
                  "items": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 64
                  },
                  "default": []
                },
                "team": {
                  "type": "string",
                  "description": "Team or organization name responsible for this project",
                  "maxLength": 128
                },
                "syncEnabled": {
                  "type": "boolean",
                  "description": "Enable GitHub sync for specs in this project (false = specs remain local-only)",
                  "default": true
                }
              },
              "required": ["id", "displayName"],
              "additionalProperties": false
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "pluginAutoLoad": {
      "type": "object",
      "description": "Plugin auto-load configuration (v1.0.140+). Controls automatic plugin detection using LLM.",
      "properties": {
        "enabled": {
          "type": "boolean",
          "description": "Enable automatic plugin detection and installation. When true, uses Claude Haiku to analyze prompts (~5-6s overhead). When false, disables detection for maximum speed.",
          "default": true
        },
        "suggestOnly": {
          "type": "boolean",
          "description": "When true, detected plugins are suggested with install commands but not auto-installed. User must install manually and restart the session. When false, plugins are installed automatically without asking.",
          "default": true
        }
      },
      "additionalProperties": false
    },
    "incrementAssist": {
      "type": "object",
      "description": "Increment assist configuration (v1.0.141+). Controls intelligent increment creation suggestions using LLM.",
      "properties": {
        "enabled": {
          "type": "boolean",
          "description": "Enable increment creation suggestions. When true, LLM analyzes prompts and suggests creating/reopening increments or proceeding without one. When false, disables suggestions for maximum speed.",
          "default": true
        },
        "suggestNewIncrement": {
          "type": "boolean",
          "description": "Suggest creating new increments for feature work, multi-file changes, new functionality that should be spec'd and tracked.",
          "default": true
        },
        "suggestReopen": {
          "type": "boolean",
          "description": "Suggest reopening existing increments when user mentions work related to recent increments (e.g., 'the login feature is broken').",
          "default": true
        },
        "confidenceThreshold": {
          "type": "number",
          "description": "Minimum confidence threshold (0.0-1.0) for showing suggestions. Higher = fewer but more confident suggestions.",
          "minimum": 0,
          "maximum": 1,
          "default": 0.7
        },
        "mandatory": {
          "type": "boolean",
          "description": "When true, BLOCKS prompts detected as implementation work until an increment is created via sw:increment. Overrides the LLM mandatory decision. Default: true (enforced).",
          "default": true
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": true,
