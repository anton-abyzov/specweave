# NOTE: gitignore has no inline comments — a "#" after a pattern is part of the
# pattern. Keep every comment on its own line.

# SpecWeave
# Runtime state / logs / backups / jobs are machine-local and regenerated
.specweave/cache/
.specweave/state/
.specweave/logs/
.specweave/backups/
.specweave/jobs/
# Increment logs and test results (folder structure is preserved)
.specweave/increments/*/logs/
.specweave/increments/*/test-results/
# Generated Docusaurus site for internal docs
.specweave/docs-site-internal/
# Framework files (plugin marketplace + plugin implementations)
.claude-plugin/
plugins/
# Work handoff (secret-scrubbed, never auto-committed)
.handoff/

# Binary evidence in reports/ (videos, screenshots, app bundles)
**/reports/*.mp4
**/reports/*.png
**/reports/*.jpg
**/reports/*.aab
**/reports/*.ipa
**/reports/*.dSYM/

# Dependencies (framework-agnostic)
# JavaScript/TypeScript
node_modules/
.pnpm-store/
.yarn/
.npm/
# Python
__pycache__/
*.pyc
*.pyo
*.pyd
.Python
venv/
env/
ENV/
# Rust
target/
Cargo.lock
# Go
vendor/
go.sum

# Build outputs (framework-agnostic)
# Next.js / Nuxt
.next/
.output/
# Generic
dist/
build/
out/
# Python
*.egg-info/
__pypackages__/
# Java
*.class
*.jar
# Go, Java
bin/

# Environment
.env
.env.local
.env.*.local
*.env

# Database (framework-agnostic)
*.db
*.sqlite
*.sqlite3
*.db-shm
*.db-wal
# Prisma (TypeScript)
prisma/migrations/*/migration.sql
# Django (Python)
*/migrations/__pycache__/

# Testing (framework-agnostic)
coverage/
.nyc_output/
.coverage
htmlcov/
*.cover
.pytest_cache/
# Playwright
test-results/

# IDEs
.vscode/
.idea/
*.swp
*.swo
*~

# OS
.DS_Store
Thumbs.db
desktop.ini

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Temporary files
*.tmp
.temp/
tmp/
