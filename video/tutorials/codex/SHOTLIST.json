{
 "series": "Your agent in SpecWithCode",
 "episode": 2,
 "agent": "codex",
 "title": "Codex in SpecWithCode",
 "resolution": "1920x1080",
 "fps": 30,
 "demoRepo": "greet-app",
 "ledgerAgent": "codex@demo",
 "labelsCheckedAt": "SpecWithCode 1.0.109 with the per-thread identity fix, 2026-10-28",
 "stepVerbs": {
  "expect": "text visible within timeout (default 20 s)",
  "click": "point at the element (role+name, text or selector), outline it, click",
  "clickIfPresent": "click only when present",
  "hover": "point and hold",
  "type": "type into the focused element",
  "press": "press a key",
  "pause": "hold for ms",
  "select": "point at a native select and pick an option",
  "waitFor": "wait until an element is visible (long timeout); the edit speed-ramps this span",
  "offCamera": "run scripts/<script> against DEMO_HOME; a click can carry it as offCameraBeforeClick"
 },
 "shots": [
  {
   "id": "01-intro",
   "kind": "MG",
   "chapter": "Intro",
   "vo": "Codex in SpecWithCode: one task, planned, built and reviewed.",
   "card": {
    "eyebrow": "SpecWithCode tutorial · Codex",
    "title": "Codex in SpecWithCode",
    "subtitle": "One task, planned, built and reviewed. The plan stays in your repo."
   }
  },
  {
   "id": "02-init",
   "kind": "TERM",
   "chapter": "Set up the repo",
   "vo": "In your repo, run specweave init. It adds AGENTS.md and seven SpecWeave skills, such as sw-increment and sw-do.",
   "stepChip": "In your repo: specweave init . --quick",
   "steps": [
    {
     "do": "command",
     "prompt": "greet-app %",
     "command": "specweave init . --quick",
     "capture": "captures/11-specweave-init-codex.json",
     "showLines": [
      "   ✓ AGENTS.md created",
      "   ✓ 7 skills installed as sw-* in .claude/skills/ and .agents/skills/"
     ],
     "lineNumbers": [
      13,
      49
     ]
    }
   ]
  },
  {
   "id": "03-connect-b",
   "kind": "APP",
   "chapter": "Connect Codex",
   "vo": "Open SpecWithCode and set this Mac up as your main machine. On the Codex card, click Use existing CLI to reuse your Codex sign-in. The card says Ready.",
   "stepChip": "Main machine → Continue → Codex: Use existing CLI → Ready",
   "steps": [
    {
     "do": "expect",
     "text": "Set this Mac up as my main machine"
    },
    {
     "do": "pause",
     "ms": 1200
    },
    {
     "do": "click",
     "text": "Set this Mac up as my main machine"
    },
    {
     "do": "pause",
     "ms": 1200
    },
    {
     "do": "click",
     "role": "button",
     "nameRegex": "^Continue$"
    },
    {
     "do": "expect",
     "text": "Use existing CLI",
     "timeout": 30000
    },
    {
     "do": "pause",
     "ms": 1500
    },
    {
     "do": "click",
     "role": "button",
     "name": "Use existing CLI",
     "last": false,
     "offCameraBeforeClick": "codex-auth.sh",
     "note": "codex-auth.sh copies this Mac's Codex login (refresh token blanked) into the demo HOME right before the click, standing in for `codex login`"
    },
    {
     "do": "expect",
     "text": "Ready",
     "timeout": 30000
    },
    {
     "do": "pause",
     "ms": 2000
    },
    {
     "do": "click",
     "role": "button",
     "nameRegex": "^Continue$",
     "last": true
    },
    {
     "do": "pause",
     "ms": 1500
    },
    {
     "do": "clickIfPresent",
     "role": "button",
     "name": "Do not import projects"
    },
    {
     "do": "pause",
     "ms": 1500
    },
    {
     "do": "clickIfPresent",
     "selector": "button[aria-label=\"Dismiss notification\"]",
     "quiet": true,
     "note": "the Updates Available toast"
    }
   ]
  },
  {
   "id": "04-project",
   "kind": "APP",
   "chapter": "Add the project",
   "vo": "Add the repo: the plus next to Projects, Local folder, then its path. The project opens on its coordinator.",
   "stepChip": "+ → Local folder → ~/greet-app",
   "steps": [
    {
     "do": "clickIfPresent",
     "selector": "button[aria-label=\"Dismiss notification\"]",
     "quiet": true
    },
    {
     "do": "click",
     "selector": "button[aria-label=\"Add project\"]"
    },
    {
     "do": "pause",
     "ms": 600
    },
    {
     "do": "click",
     "selector": "div[role=option]:has-text(\"Local folder\")"
    },
    {
     "do": "pause",
     "ms": 600
    },
    {
     "do": "type",
     "text": "~/greet-app",
     "delay": 60
    },
    {
     "do": "press",
     "key": "Enter"
    },
    {
     "do": "expect",
     "text": "Ask the coordinator",
     "timeout": 30000
    },
    {
     "do": "clickIfPresent",
     "selector": "button[aria-label=\"Dismiss notification\"]",
     "quiet": true
    },
    {
     "do": "pause",
     "ms": 2500
    }
   ]
  },
  {
   "id": "05-task",
   "kind": "APP",
   "chapter": "Send the task",
   "vo": "Set Full access for this demo, describe the change, and send it. The coordinator hands the work to a new thread.",
   "stepChip": "Full access → describe the change → Enter",
   "steps": [
    {
     "do": "select",
     "selector": "select[aria-label=\"Project permissions\"]",
     "option": "Full access"
    },
    {
     "do": "pause",
     "ms": 800
    },
    {
     "do": "click",
     "selector": "textarea"
    },
    {
     "do": "type",
     "text": "Add a personal greeting: greet(name) returns \"Hello, <name>!\" and greet() still returns \"Hello, world!\". Use Ada in examples. Plan it with sw-increment, then build it with sw-do.",
     "delay": 14
    },
    {
     "do": "press",
     "key": "Enter"
    },
    {
     "do": "expect",
     "text": "Routed to",
     "timeout": 180000
    },
    {
     "do": "pause",
     "ms": 2000
    }
   ]
  },
  {
   "id": "06-work",
   "kind": "APP",
   "chapter": "Plan, build, test",
   "vo": "The thread plans increment 0001: acceptance criteria and one task with its test. Then it changes the code and runs that test. A task is done only when its test passes.",
   "stepChip": "Increment 0001 → acceptance criteria → task → test",
   "steps": [
    {
     "do": "click",
     "role": "button",
     "nameRegex": "^Open thread ",
     "last": true
    },
    {
     "do": "pause",
     "ms": 2000
    },
    {
     "do": "waitFor",
     "role": "button",
     "nameRegex": "^Open thread .*Done$",
     "timeout": 900000,
     "note": "speed-ramped in the edit"
    },
    {
     "do": "pause",
     "ms": 2500
    }
   ]
  },
  {
   "id": "07-review",
   "kind": "APP",
   "chapter": "Review",
   "vo": "Open the thread to review it: the summary, the verification and review reports, and every changed file in Open diff.",
   "stepChip": "Summary · verify.md · review.md · Open diff",
   "steps": [
    {
     "do": "expect",
     "text": "verify.md",
     "timeout": 30000
    },
    {
     "do": "hover",
     "role": "link",
     "name": "verify.md",
     "ms": 1200
    },
    {
     "do": "hover",
     "role": "link",
     "name": "review.md",
     "ms": 1200
    },
    {
     "do": "click",
     "role": "button",
     "name": "Open diff",
     "last": true
    },
    {
     "do": "pause",
     "ms": 2500
    },
    {
     "do": "clickIfPresent",
     "role": "button",
     "nameRegex": "^Expand .*src/greeting\\.js$"
    },
    {
     "do": "pause",
     "ms": 3500
    }
   ]
  },
  {
   "id": "08-outro",
   "kind": "MG",
   "chapter": "Next",
   "vo": "Increment 0001 is verified and closed. Next, run the same task with another agent.",
   "card": {
    "lines": [
     "Increment 0001: verified and closed",
     "SpecWithCode · free, early access · spec-weave.com/code",
     "All tutorials · spec-weave.com/tutorials"
    ]
   }
  }
 ]
}
