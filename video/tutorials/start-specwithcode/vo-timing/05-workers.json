{"id":"05-workers","duration":25.76,"cues":[{"text":"The coordinator does none of the work itself.","start":0,"end":2.68},{"text":"It starts two worker threads,","start":2.88,"end":4.64},{"text":"and they appear in the right panel under Working.","start":4.76,"end":7.28},{"text":"Each one gets a brief: claim, implement, test, close and report.","start":7.76,"end":13.12},{"text":"The workers share one checkout, so each works on its own files.","start":13.44,"end":17.76},{"text":"Each plan chip counts the increment's tasks done,","start":17.84,"end":20.64},{"text":"from zero to two of two.","start":20.72,"end":22.72},{"text":"The whole run took under a minute; it's sped up here.","start":22.8,"end":25.76}],"words":[[0,"the",0,0.16],[0,"coordinator",0.24,0.8],[0,"does",0.88,1.04],[0,"none",1.28,1.36],[0,"of",1.44,1.52],[0,"the",1.56,1.6],[0,"work",1.68,1.84],[0,"itself",1.96,2.68],[1,"it",2.88,2.96],[1,"starts",3.04,3.44],[1,"two",3.56,3.68],[1,"worker",3.76,4.08],[1,"threads",4.16,4.64],[2,"and",4.76,4.88],[2,"they",4.96,5.04],[2,"appear",5.24,5.44],[2,"in",5.52,5.56],[2,"the",5.6,5.68],[2,"right",5.76,5.92],[2,"panel",6,6.48],[2,"under",6.6,6.72],[2,"working",6.8,7.28],[3,"each",7.76,8],[3,"one",8.08,8.16],[3,"gets",8.24,8.4],[3,"a",8.44,8.48],[3,"brief",8.68,9.28],[3,"claim",9.48,10],[3,"implement",10.28,10.8],[3,"test",11,11.52],[3,"close",11.76,12.16],[3,"and",12.2,12.24],[3,"report",12.52,13.12],[4,"the",13.44,13.48],[4,"workers",13.52,14],[4,"share",14.16,14.32],[4,"one",14.48,14.64],[4,"checkout",14.72,15.36],[4,"so",15.48,15.6],[4,"each",15.68,15.84],[4,"works",15.92,16.16],[4,"on",16.2,16.24],[4,"its",16.36,16.48],[4,"own",16.6,16.72],[4,"files",16.8,17.76],[5,"each",17.84,18],[5,"plan",18.08,18.32],[5,"chip",18.4,18.64],[5,"counts",18.72,18.96],[5,"the",19.04,19.12],[5,"increments",19.32,19.68],[5,"tasks",19.88,20.08],[5,"done",20.16,20.64],[6,"from",20.72,20.8],[6,"zero",20.88,21.2],[6,"to",21.36,21.6],[6,"two",21.68,21.76],[6,"of",21.88,22],[6,"two",22.12,