{
 "series": "Your agent in SpecWithCode",
 "episode": 6,
 "agent": "antigravity",
 "title": "Antigravity in SpecWithCode",
 "resolution": "1920x1080",
 "fps": 30,
 "demoRepo": "greet-app",
 "ledgerAgent": "antigravity@demo",
 "labelsCheckedAt": "SpecWithCode 1.0.111 with Antigravity ACP 1.3.0, 2026-10-28",
 "stepVerbs": {
  "expect": "text visible within timeout (default 20 s)",
  "click": "point at the element (role+name, text or selector), outline it, click",
  "clickIfPresent": "click only when present",
  "hover": "point and hold",
  "type": "type into the focused element",
  "press": "press a key",
  "pause": "hold for ms",
  "select": "point at a native select and pick an option",
  "waitFor": "wait until an element is visible (long timeout); the edit speed-ramps this span",
  "offCamera": "run scripts/<script> against DEMO_HOME; a click can carry it as offCameraBeforeClick"
 },
 "shots": [
  {
   "id": "01-intro",
   "kind": "MG",
   "chapter": "Intro",
   "vo": "Antigravity in SpecWithCode: one task, planned, built and reviewed with Gemini.",
   "card": {
    "eyebrow": "SpecWithCode tutorial · Antigravity",
    "title": "Antigravity in SpecWithCode",
    "subtitle": "One task, planned, built and reviewed with Gemini. The plan stays in your repo."
   }
  },
  {
   "id": "02-init",
   "kind": "TERM",
   "chapter": "Set up the repo",
   "vo": "In your repo, run specweave init. It adds AGENTS.md and seven SpecWeave skills, such as sw-increment and sw-do.",
   "stepChip": "In your repo: specweave init . --quick",
   "steps": [
    {
     "do": "command",
     "prompt": "greet-app %",
     "command": "specweave init . --quick",
     "capture": "captures/11-specweave-init-antigravity.json",
     "showLines": [
      "   ✓ AGENTS.md created",
      "   ✓ 7 skills installed as sw-* in .claude/skills/ and .agents/skills/"
     ],
     "lineNumbers": [
      13,
      129
     ]
    }
   ]
  },
  {
   "id": "03-setup",
   "kind": "APP",
   "chapter": "Set up SpecWithCode",
   "vo": "Open SpecWithCode and set this Mac up as your main machine. Antigravity isn't in the first-run list, so continue past it.",
   "stepChip": "Main machine → Continue → Continue → Do not import projects",
   "steps": [
    {
     "do": "expect",
     "text": "Set this Mac up as my main machine"
    },
    {
     "do": "pause",
     "ms": 1200
    },
    {
     "do": "click",
     "text": "Set this Mac up as my main machine"
    },
    {
     "do": "pause",
     "ms": 1200
    },
    {
     "do": "click",
     "role": "button",
     "nameRegex": "^Continue$"
    },
    {
     "do": "pause",
     "ms": 2500
    },
    {
     "do": "click",
     "role": "button",
     "nameRegex": "^Continue$",
     "last": true
    },
    {
     "do": "pause",
     "ms": 1500
    },
    {
     "do": "clickIfPresent",
     "role": "button",
     "name": "Do not import projects"
    },
    {
     "do": "pause",
     "ms": 1500
    },
    {
     "do": "clickIfPresent",
     "selector": "button[aria-label=\"Dismiss notification\"]",
     "quiet": true
    }
   ]
  },
  {
   "id": "04-connect",
   "kind": "APP",
   "chapter": "Connect Antigravity",
   "vo": "In Settings, Providers, click Add provider, pick Antigravity, then Next, Next, and Add instance. SpecWithCode installs its own Antigravity agent. Sign in with your Google account; this one is already signed in.",
   "stepChip": "Settings → Providers → Add provider → Antigravity → Add instance",
   "steps": [
    {
     "do": "clickIfPresent",
     "selector": "button[aria-label=\"Dismiss notification\"]",
     "quiet": true
    },
    {
     "do": "click",
     "selector": "button[aria-label=\"Account: Demo Mac\"]"
    },
    {
     "do": "pause",
     "ms": 700
    },
    {
     "do": "click",
     "selector": "div[role=menuitem]:has-text(\"Settings\")"
    },
    {
     "do": "pause",
     "ms": 1200
    },
    {
     "do": "click",
     "selector": "button:has-text(\"Providers\")"
    },
    {
     "do": "pause",
     "ms": 1200
    },
    {
     "do": "click",
     "selector": "button:has-text(\"Add provider\")"
    },
    {
     "do": "pause",
     "ms": 1000
    },
    {
     "do": "click",
     "selector": "[role=radio]:has-text(\"Antigravity\")"
    },
    {
     "do": "pause",
     "ms": 700
    },
    {
     "do": "click",
     "role": "button",
     "name": "Next"
    },
    {
     "do": "pause",
     "ms": 900
    },
    {
     "do": "click",
     "role": "button",
     "name": "Next"
    },
    {
     "do": "pause",
     "ms": 900
    },
    {
     "do": "click",
     "role": "button",
     "name": "Add instance",
     "note": "the agent runtime was copied into the demo base dir before the take, so it is already installed; the Google sign-in token was copied too, standing in for Sign in"
    },
    {
     "do": "pause",
     "ms": 2000
    },
    {
     "do": "clickIfPresent",
     "selector": "button[aria-label=\"Select Antigravity\"]"
    },
    {
     "do": "click",
     "selector": "button:visible:has-text(\"Checked\")",
     "note": "Refresh provider status; it reads the Google sign-in"
    },
    {
     "do": "waitFor",
     "timeout": 90000,
     "note": "speed-ramped",
     "textRegex": "^Authenticated · Google account"
    },
    {
     "do": "pause",
     "ms": 2500
    },
    {
     "do": "press",
     "key": "Escape"
    },
    {
     "do": "pause",
     "ms": 1000
    }
   ]
  },
  {
   "id": "05-project",
   "kind": "APP",
   "chapter": "Add the project",
   "vo": "Add the repo: the plus next to Projects, Local folder, then its path. The project opens on its coordinator, and the model picker already shows Gemini 3.8 Flash.",
   "stepChip": "+ → Local folder → ~/greet-app",
   "steps": [
    {
     "do": "clickIfPresent",
     "selector": "button[aria-label=\"Dismiss notification\"]",
     "quiet": true
    },
    {
     "do": "click",
     "selector": "button[aria-label=\"Add project\"]"
    },
    {
     "do": "pause",
     "ms": 600
    },
    {
     "do": "click",
     "selector": "div[role=option]:has-text(\"Local folder\")"
    },
    {
     "do": "pause",
     "ms": 600
    },
    {
     "do": "type",
     "text": "~/greet-app",
     "delay": 60
    },
    {
     "do": "press",
     "key": "Enter"
    },
    {
     "do": "expect",
     "text": "Excited to get started on greet-app",
     "timeout": 30000,
     "note": "a new project opens on its coordinator with a welcome and suggested first threads"
    },
    {
     "do": "clickIfPresent",
     "selector": "button[aria-label=\"Dismiss notification\"]",
     "quiet": true
    },
    {
     "do": "hover",
     "ms": 1500,
     "selector": "button[aria-label^=\"Coordinator model\"]"
    },
    {
     "do": "pause",
     "ms": 2500
    }
   ]
  },
  {
   "id": "06-task",
   "kind": "APP",
   "chapter": "Send the task",
   "vo": "Set Full access for this demo, describe the change, and send it. The coordinator hands the work to a new thread.",
   "stepChip": "Full access → describe the change → Enter",
   "steps": [
    {
     "do": "select",
     "selector": "select[aria-label=\"Project permissions\"]",
     "option": "Full access"
    },
    {
     "do": "pause",
     "ms": 800
    },
    {
     "do": "click",
     "selector": "textarea"
    },
    {
     "do": "type",
     "text": "Add a personal greeting: greet(name) returns \"Hello, <name>!\" and greet() still returns \"Hello, world!\". Use Ada in examples. Plan it with sw-increment, then build it with sw-do.",
     "delay": 14
    },
    {
     "do": "press",
     "key": "Enter"
    },
    {
     "do": "waitFor",
     "role": "button",
     "nameRegex": "^Open thread ",
     "timeout": 240000,
     "note": "the coordinator replies \"Assigned to <thread>\" and links the new thread; speed-ramped"
    },
    {
     "do": "pause",
     "ms": 2000
    }
   ]
  },
  {
   "id": "07-work",
   "kind": "APP",
   "chapter": "Plan, build, test",
   "vo": "The thread plans increment 1: acceptance criteria and one task with its test. Then it changes the code and runs that test. A task is done only when its test passes.",
   "stepChip": "Increment 0001 → acceptance criteria → task → test",
   "steps": [
    {
     "do": "clickIfPresent",
     "selector": "button[aria-label=\"Dismiss notification\"]",
     "quiet": true
    },
    {
     "do": "click",
     "role": "button",
     "nameRegex": "^Open thread ",
     "last": true
    },
    {
     "do": "pause",
     "ms": 2000
    },
    {
     "do": "waitFor",
     "role": "button",
     "nameRegex": "^Open thread .*Done$",
     "timeout": 900000,
     "note": "speed-ramped in the edit"
    },
    {
     "do": "pause",
     "ms": 2500
    }
   ]
  },
  {
   "id": "08-review",
   "kind": "APP",
   "chapter": "Review",
   "vo": "Open the thread to review it: the summary, the verification and review reports, and every changed file in Open diff.",
   "stepChip": "Summary · verify.md · review.md · Open diff",
   "steps": [
    {
     "do": "clickIfPresent",
     "selector": "button[aria-label=\"Dismiss notification\"]",
     "quiet": true
    },
    {
     "do": "hover",
     "textRegex": "^Increment 0001",
     "ms": 1500,
     "note": "the thread header: Increment 0001, All done"
    },
    {
     "do": "hover",
     "text": "specweave verify",
     "ms": 1500,
     "optional": true,
     "note": "the worker's own summary; its wording varies by model"
    },
    {
     "do": "click",
     "role": "button",
     "name": "Open diff",
     "last": true
    },
    {
     "do": "pause",
     "ms": 800
    },
    {
     "do": "clickIfPresent",
     "selector": "button[aria-label=\"Dismiss notification\"]",
     "quiet": true
    },
    {
     "do": "hover",
     "textRegex": "reports/verify\\.md$",
     "ms": 900
    },
    {
     "do": "hover",
     "textRegex": "reports/review\\.md$",
     "ms": 900
    },
    {
     "do": "clickIfPresent",
     "role": "button",
     "nameRegex": "^Collapse .*ledger\\.jsonl$",
     "note": "the ledger opens expanded; fold it so the code diff fits"
    },
    {
     "do": "click",
     "role": "button",
     "name": "Expand src/greeting.js"
    },
    {
     "do": "pause",
     "ms": 3500
    }
   ]
  },
  {
   "id": "09-outro",
   "kind": "MG",
   "chapter": "Next",
   "vo": "Increment 1 is verified and closed. Next, run the same task with another agent.",
   "card": {
    "lines": [
     "Increment 0001: verified and closed",
     "SpecWithCode · free, early access · spec-weave.com/code",
     "All tutorials · spec-weave.com/tutorials"
    ]
   }
  }
 ]
}