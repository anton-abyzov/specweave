    {
      "id": "06-plan",
      "kind": "APP",
      "chapter": "Plan",
      "startSec": 50,
      "durationSec": 13,
      "vo": "Type a dollar sign, pick sw-increment, and describe the change. Cursor writes spec.md: acceptance criteria and a task with its files and test.",
      "spokenWords": 28,
      "stepChip": "$ → sw-increment → describe the change → Enter",
      "steps": [
        {
          "do": "click",
          "target": "composer",
          "note": "placeholder \"Ask anything, @tag files/folders, $use skills, or / for commands\""
        },
        {
          "do": "type",
          "text": "$"
        },
        {
          "do": "expect",
          "text": "Searching workspace skills...",
          "note": "then the 11 sw-* skills"
        },
        {
          "do": "click",
          "role": "option",
          "name": "sw-increment"
        },
        {
          "do": "type",
          "text": "Personal greeting: greet(name) returns \"Hello, <name>!\" and greet() still returns \"Hello, world!\". Use Ada in examples. Plan only, no code yet."
        },
        {
          "do": "press",
          "key": "Enter",
          "note": "send button aria-label \"Submit message\""
        },
        {
          "do": "ramp",
          "factor": "4-8x",
          "until": "the reply ends"
        },
        {
          "do": "highlight",
          "in": ".specweave/increments/0001-…/spec.md (the edit in the thread)",
          "lines": [
            "- [ ] AC-01 …",
            "- [ ] AC-02 …",
            "### T-01 …",
            "- AC: … | Files: … | Test: …"
          ]
        }
      ]
    },
    {
      "id": "07-build",
      "kind": "APP",
      "chapter": "Build",
      "startSec": 63,
      "durationSec": 12,
      "vo": "Then send sw-do. Cursor claims the task, changes the code, and runs the test. The task is marked done only when the test passes.",
      "spokenWords": 26,
      "stepChip": "$ → sw-do → claim → edit → test → done",
      "steps": [
        {
          "do": "type",
          "text": "$"
        },
        {
          "do": "click",
          "role": "option",
          "name": "sw-do"
        },
        {
          "do": "type",
          "text": "Do T-01, then stop. I will close the increment myself."
        },
        {
          "do": "press",
          "key": "Enter"
        },
        {
          "do": "ramp",
          "factor": "4-8x",
          "until": "T-01 is done"
        },
        {
          "do": "hold",
          "sec": 1,
          "on": "specweave task claim T-01"
        },
        {
          "do": "hold",
          "sec": 1,
          "on": "the edit to src/greeting.js"
        },
        {
          "do": "hold",
          "sec": 1,
          "on": "npm test passing"
        },
        {
          "do": "hold",
          "sec": 1,
          "on": "specweave task done T-01 … --run \"npm test\""
        }
      ]
    },
    {
      "id": "08-review",
      "kind": "APP",
      "chapter": "Review",
      "startSec": 75,
      "durationSec": 9,
      "vo": "Click Open diff to review the code, the test, and the ledger line that records who finished the task.",
      "spokenWords": 19,
      "stepChip": "Open diff → code · test · ledger.jsonl",
      "steps": [
        {
          "do": "click",
          "role": "button",
          "name": "Open diff",
          "note": "on the last turn's \"N changed files\" card; tooltip \"Open the full diff\""
        },
        {
          "do": "step",
          "files": [
            "src/greeting.js",
            "test/greeting.test.js",
            ".specweave/increments/0001-…/ledger.jsonl"
          ]
        },
        {
          "do": "highlight",
          "in": "ledger.jsonl",
          "lines": [
            "\"e\":\"done\" with \"by\":\"cursor@demo\" and \"evidence\""
          ]
        }
      ]
    },
