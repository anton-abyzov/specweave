    {
      "id": "05-project-chat",
      "kind": "APP",
      "chapter": "Add the project",
      "startSec": 37,
      "durationSec": 13,
      "vo": "Add the repo: the plus next to Projects, Local folder, then its path. Click New chat, pick Cursor in the model picker, and set Full access for this demo.",
      "spokenWords": 29,
      "stepChip": "Projects + → Local folder → ~/greet-app · New chat → Cursor · Full access",
      "steps": [
        {
          "do": "click",
          "role": "button",
          "name": "Add project",
          "note": "the + next to Projects; tooltip \"New project or assistant\""
        },
        {
          "do": "click",
          "role": "option",
          "name": "Local folder",
          "note": "\"New project\" and \"Personal assistant\" rows can sit above it"
