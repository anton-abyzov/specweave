        {
          "do": "type",
          "into": "Enter path (e.g. ~/projects/my-app)",
          "text": "~/greet-app"
        },
        {
          "do": "press",
          "key": "Enter"
        },
        {
          "do": "expect",
          "text": "greet-app",
          "note": "listed under Projects"
        },
        {
          "do": "click",
          "role": "button",
          "name": "New chat"
        },
        {
          "do": "expect",
          "text": "What should we build in greet-app?"
