    {
      "id": "02-init",
      "kind": "TERM",
      "chapter": "Set up the repo",
      "startSec": 4,
      "durationSec": 10,
      "vo": "In your repo, run specweave init with the Cursor adapter. It adds AGENTS.md and eleven SpecWeave skills.",
      "spokenWords": 22,
      "stepChip": "In your repo: specweave init . --quick --adapter cursor",
      "steps": [
        {
          "do": "command",
          "prompt": "greet-app %",
          "command": "specweave init . --quick --adapter cursor",
          "capture": "captures/02-specweave-init-cursor.json",
          "showLines": [
            "   ✓ AGENTS.md created",
            "   ✓ 11 skills installed as sw-* in .claude/skills/ and .agents/skills/"
