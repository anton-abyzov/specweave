    {
      "id": "02-init",
      "kind": "TERM",
      "chapter": "Set up the repo",
      "startSec": 4,
      "durationSec": 8,
      "vo": "In your repo, run specweave init. It adds AGENTS.md and eleven SpecWeave skills.",
      "spokenWords": 18,
      "stepChip": "In your repo: specweave init . --quick",
      "steps": [
        {
          "do": "command",
          "prompt": "greet-app %",
          "command": "specweave init . --quick",
          "capture": "captures/03-specweave-init.json",
          "showLines": [
            "   ✓ AGENTS.md created",
            "   ✓ 11 skills installed as sw-* in .claude/skills/ and .agents/skills/"
          ],
          "lineNumbers": [
            12,
            16
          ],
          "elide": "dim … row between and after the two lines"
        }
      ]
    },
    {
      "id": "03-connect",
      "kind": "APP",
      "chapter": "Connect Claude Code",
      "startSec": 12,
      "durationSec": 16,
      "vo": "Open SpecWithCode. In setup, keep this computer and click Continue. The Claude Code card should say Ready to code. If it says Sign in, click it, then press Enter to run claude auth login.",
      "spokenWords": 36,
      "stepChip": "Setup → Continue → Claude Code: Ready to code (or Sign in) → Continue → Do not import projects",
      "steps": [
        {
          "do": "expect",
          "text": "Set up SpecWithCode",
          "note": "v0.2.4 says \"Set up SpecWeave Studio\"; steps Connect, Agents, Projects"
        },
        {
          "do": "expect",
          "text": "Connect your computers"
        },
        {
          "do": "blur",
          "target": "computer row label (host name)"
        },
        {
          "do": "click",
          "role": "button",
          "name": "Continue"
        },
        {
          "do": "expect",
          "text": "Connect your agents"
        },
        {
          "do": "hover",
          "target": "Claude Code card",
          "expect": "Ready to code."
        },
        {
          "do": "insert",
          "sec": 3,
          "note": "second take where the card shows Sign in: click it; the terminal opens with `claude auth login` typed, not sent. Cut before Enter."
        },
        {
          "do": "click",
          "role": "button",
          "name": "Continue"
        },
        {
          "do": "click",
          "role": "button",
          "name": "Do not import projects"
        }
      ]
    },
    {
      "id": "04-project-chat",
      "kind": "APP",
      "chapter": "Add the project",
      "startSec": 28,
      "durationSec": 13,
      "vo": "Add the repo: the plus next to Projects, Local folder, then its path. Click New chat, pick Claude in the model picker, and set Full access for this demo.",
      "spokenWords": 29,
      "stepChip": "Projects + → Local folder → ~/greet-app · New chat → Claude · Full access",
      "steps": [
        {
          "do": "click",
          "role": "button",
          "name": "Add project",
          "note": "the + next to Projects; tooltip \"New project or assistant\""
        },
        {
          "do": "click",
          "role": "option",
          "name": "Local folder",
          "note": "\"New project\" and \"Personal assistant\" rows can sit above it"
        },
        {
          "do": "type",
          "into": "Enter path (e.g. ~/projects/my-app)",
          "text": "~/greet-app"
        },
        {
          "do": "press",
          "key": "Enter"
        },
        {
          "do": "expect",
          "text": "greet-app",
          "note": "listed under Projects"
        },
        {
          "do": "click",
          "role": "button",
          "name": "New chat"
        },
        {
          "do": "expect",
          "text": "What should we build in greet-app?"
        },
        {
          "do": "click",
          "target": "model picker (labelled with the current model)"
        },
        {
          "do": "click",
          "target": "Providers rail → Claude → Claude Sonnet 5.5"
        },
        {
          "do": "click",
          "target": "Runtime mode → Full access"
        },
        {
          "do": "expect",
          "text": "Current checkout",
          "note": "leave the workspace on the current checkout"
        }
      ]
    },
    {
      "id": "05-plan",
      "kind": "APP",
      "chapter": "Plan",
      "startSec": 41,
      "durationSec": 13,
      "vo": "Type a dollar sign, pick sw-increment, and describe the change. Claude writes spec.md: acceptance criteria and a task with its files and test.",
      "spokenWords": 28,
      "stepChip": "$ → sw-increment → describe the change → Enter",
      "steps": [
        {
          "do": "click",
          "target": "composer",
          "note": "placeholder \"Ask anything, @tag files/folders, $use skills, or / for commands\""
        },
        {
          "do": "type",
          "text": "$"
        },
        {
          "do": "expect",
          "text": "Searching workspace skills...",
          "note": "then the 11 sw-* skills"
        },
        {
          "do": "click",
          "role": "option",
          "name": "sw-increment"
        },
        {
          "do": "type",
          "text": "Personal greeting: greet(name) returns \"Hello, <name>!\" and greet() still returns \"Hello, world!\". Use Ada in examples. Plan only, no code yet."
        },
        {
          "do": "press",
          "key": "Enter",
          "note": "send button aria-label \"Submit message\""
        },
        {
          "do": "ramp",
          "factor": "4-8x",
          "until": "the reply ends"
        },
        {
          "do": "highlight",
          "in": ".specweave/increments/0001-…/spec.md (the edit in the thread)",
          "lines": [
            "- [ ] AC-01 …",
            "- [ ] AC-02 …",
            "### T-01 …",
            "- AC: … | Files: … | Test: …"
          ]
        }
      ]
    },
    {
      "id": "06-build",
      "kind": "APP",
      "chapter": "Build",
      "startSec": 54,
      "durationSec": 12,
      "vo": "Then send sw-do. Claude claims the task, changes the code, and runs the test. The task is marked done only when the test passes.",
      "spokenWords": 26,
      "stepChip": "$ → sw-do → claim → edit → test → done",
      "steps": [
        {
          "do": "type",
          "text": "$"
        },
        {
          "do": "click",
          "role": "option",
          "name": "sw-do"
        },
        {
          "do": "type",
          "text": "Do T-01, then stop. I will close the increment myself."
        },
        {
          "do": "press",
          "key": "Enter"
        },
        {
          "do": "ramp",
          "factor": "4-8x",
          "until": "T-01 is done"
        },
        {
          "do": "hold",
          "sec": 1,
          "on": "specweave task claim T-01"
        },
        {
          "do": "hold",
          "sec": 1,
          "on": "the edit to src/greeting.js"
        },
        {
          "do": "hold",
          "sec": 1,
          "on": "npm test passing"
        },
        {
          "do": "hold",
          "sec": 1,
          "on": "specweave task done T-01 … --run \"npm test\""
        }
      ]
    },
    {
      "id": "07-review",
      "kind": "APP",
      "chapter": "Review",
      "startSec": 66,
      "durationSec": 9,
      "vo": "Click Open diff to review the code, the test, and the ledger line that records who finished the task.",
      "spokenWords": 19,
      "stepChip": "Open diff → code · test · ledger.jsonl",
      "steps": [
        {
          "do": "click",
          "role": "button",
          "name": "Open diff",
          "note": "on the last turn's \"N changed files\" card; tooltip \"Open the full diff\""
        },
        {
          "do": "step",
          "files": [
            "src/greeting.js",
            "test/greeting.test.js",
            ".specweave/increments/0001-…/ledger.jsonl"
          ]
        },
        {
          "do": "highlight",
          "in": "ledger.jsonl",
          "lines": [
            "\"e\":\"done\" with \"by\":\"claude@demo\" and \"evidence\""
          ]
        }
      ]
