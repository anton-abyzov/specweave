{
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit",
        "matcher_content": "\\.specweave/increments/[0-9]{4}-.+/(tasks|spec)\\.md",
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PLUGIN_ROOT}/hooks/post-task-edit.sh"
          }
        ]
      }
    ]
  }
}
