# SpecWeave generated files
.specweave/cache/
.specweave/feedback/
.specweave/logs/
.specweave/docs-site-internal/

# SpecWeave developer-local config (multi-developer support)
# Each developer can have their own config.local.json for:
#   - developerId: 2-char ID for multi-dev increment naming
#   - preferences: personal settings that shouldn't affect team
.specweave/config.local.json

# SpecWeave runtime state (auto mode, hooks, sessions)
# This directory contains:
#   - auto-session.json       # Active /sw:auto session state
#   - heartbeat.json          # Session liveness detection (pid, timestamp)
#   - task-checkpoint.json    # Crash recovery checkpoints
#   - active-session.lock     # Session lock to prevent concurrent runs
#   - active-increment.json   # Currently active increment
#   - dashboard.json          # Status dashboard cache
#   - status-line.json        # Status line cache for performance
#   - background-jobs.json    # Background job tracking
#   - *.pid                   # Process ID files (watchdog, processor)
#   - .*.lock / .*.lock.d/    # Lock files and directories
#   - event-queue/            # Hook event queue (async processing)
#   - metrics/                # Hook performance metrics
#   - analytics/              # Usage analytics (events.jsonl)
#   - jobs/                   # Background job state
#   - semaphores/             # Hook semaphores
#   - .github-sync-*          # GitHub sync throttle files
#   - .living-specs-*         # Living specs sync state
#   - .us-completion-*        # User story completion tracking
#   - .prev-status-*          # Previous status for change detection
#   - .project-bridge-*       # Multi-project bridge state
.specweave/state/

# Increment logs (inside each increment folder)
.specweave/increments/*/logs/
.specweave/increments/*/scripts/*.tmp
.specweave/increments/*/reports/*.tmp

# Plugin system (v0.4.0+)
# Note: src/plugins/ IS source code and should be committed (SpecWeave repo)
# Only installed plugins in user projects are ignored
.specweave/plugins/installed/
.specweave/plugins/cache/

# Claude Code development mode installation (ignored - generated)
.claude/

# BUT: Keep these team configuration files (source code)
!.claude/settings.json
!.claude-plugin/

# Test results (generated, review before committing)
test-results/
**/test-results/
*.test-result.md
src/skills/**/test-results/
src/agents/**/test-results/

# Playwright test results
playwright-report/
.playwright/

# ML Pipeline Test Artifacts (entire directory - reproducible by tests)
# These are generated by: npm run test:ml:pipeline
# Includes: datasets, frames, training runs, detection outputs, Python scripts
.specweave/test-runs/
!.specweave/test-runs/.gitkeep

# ML Experiment Tracking (MLflow runtime data)
mlruns/

# ML Training Runs (YOLO/Ultralytics default output)
runs/

# OS
.DS_Store
Thumbs.db

# Temporary files
tmp/
temp/
*.tmp

# CI artifacts (generated by GitHub Actions workflows)
failure-logs.txt

# DEPRECATED: ai-logs/ folder removed in favor of increment-centric organization
# All logs, scripts, and reports now live in .specweave/increments/{increment-id}/
# This keeps all increment-related files together for better traceability
# Workflow trigger - increment 0014 cleanup
*.bak
*.backup
coverage/

# ROOT FOLDER POLLUTION PREVENTION
# Only allow these files in root (see CLAUDE.md):
# ✅ CLAUDE.md, README.md, CHANGELOG.md, LICENSE, CODE_OF_CONDUCT.md, SECURITY.md
# ✅ package.json, package-lock.json, tsconfig*.json, jest.config.*, playwright.config.ts
# ✅ .gitignore, .gitattributes, .npmignore, .mermaidrc.json
# ✅ Directories: src/, tests/, plugins/, .specweave/, docs-site/, scripts/, bin/
# ❌ Everything else (*.md reports, *.js scripts, *.log files) → Use increment folders!

# Prevent common root folder violations
/*-SUMMARY*.md
/*-REPORT*.md
/*-ANALYSIS*.md
/*-COMPLETE*.md
/*-GUIDE*.md
/*-FIX*.md
/*-CLEANUP*.md
/*-VALIDATION*.md
/*-MODE*.md
/SESSION-*.md
/IMPLEMENTATION-*.md
/PHASE-*.md
/AUTO-*.md
/AUTO-*.txt
/JUDGE-*.md
/LIVING-*.md
/LOCK-*.md
/ULTRATHINK-*.md
/INIT-*.md
/*.md.backup*
/test-*.js
/debug-*.js
/build-output.log
/build-*.log
/*.log

# Empty temporary directories in root
/static/
/test-fixtures/

# Legacy documentation (moved to docs-site/legacy/)
/MESSAGE_TO_USER.md
/NVM_GLOBAL_PACKAGES_SOLUTION.md

# MCP/Playwright test artifacts (screenshots, traces, etc.)
.playwright-mcp/
.*-mcp/

# Accidental test workspace folders
enterprise-health/
/docs/

# Plugin-specific configs should NOT be in root (belong in plugins/*/)
.eslintrc.*.json
.prettierrc.*.json
!.eslintrc.json
!.prettierrc.json

# Claude Code hooks (NOT needed - hooks live in plugins/)
.claude/hooks/

# Compiled plugin TypeScript files (generated by esbuild)
plugins/**/lib/*.js
plugins/**/lib/*.js.map

# Compiled TypeScript files in src/ (should only exist in dist/)
# TypeScript outDir is ./dist, so .js files in src/ are build artifacts
src/**/*.js
src/**/*.js.map
src/**/*.d.ts
src/**/*.d.ts.map
.test-fix-duplicates/

# Temporary backups (do not commit)
dist-backup/

# External content (marketing/non-technical content)
youtube-content/
