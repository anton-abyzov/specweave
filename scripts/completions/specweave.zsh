#compdef specweave
#
# Zsh completion for SpecWeave CLI
# DO NOT EDIT BY HAND - generated by scripts/completions/generate.mjs
#
# Installation: copy to your fpath as _specweave
#

local -a commands
commands=(
    'init:Initialize a new SpecWeave project'
    'uninstall:Remove SpecWeave from the current project'
    'pause:Pause an active increment'
    'start:Start a planned/backlog/paused increment (status -> active)'
    'resume:Resume a paused, abandoned or not-yet-started increment'
    'reopen:Correct a completed increment back to planned (never active); needs --reason and --workspace'
    'abandon:Abandon an increment'
    'complete:Complete one or more increments (triggers GitHub/JIRA/ADO sync)'
    'task:Task ledger\: list | next | claim | done | release | block | skip | render | whoami'
    'ac:Acceptance criteria\: accept-skip <AC-id> [inc] (a person accepted skipping one named check; never verification) | list [inc]'
    'card:Cards\: add "<text>" | start <id> | done <id> | wait <id> | list. T-NN ids alias `task`; C-NN cards live in .specweave/cards/<branch>.jsonl'
    'cards:Print the card checklist\: a header, a blank line, then one ✓ / ✱ / ○ line per card with its link'
    'verify:'
    'review:Review an increment with a model from another family than the author (Codex for Claude-written code); writes reports/review-<reviewer>.md'
    'skills:List the project'\''s SpecWeave skills, or enable/disable optional ones (glossary, sync, project, jev)'
    'glossary:Check GLOSSARY.md against the code (avoided words used as identifiers, Data/Code names that no longer exist); list prints the terms'
    'create-increment:Create an increment\: metadata.json and spec.md (Problem, Scope, ACs, Approach, Tasks). Short form\: specweave create-increment "Add login form"'
    'handoff:Hand off your work\: release your claims, record why, and push it so `specweave pickup` continues it in any tool or account. `specweave handoff list` shows the pending handoffs'
    'pickup:Pick up handed-off work (from any tool, machine or account) and print the next task with its acceptance criteria. Name one handoff by its id (`specweave handoff list`), increment or title words; with none named, the newest'
    'report:Write an HTML report of who did what on an increment (tools, sessions, handoffs, pickups, evidence)'
    'note:Append a note to an increment'\''s ledger; `specweave pickup` shows it to the next agent'
    'auto-handoff:on | off | status\: near the usage limit, suggest a handoff (default) or hand off by itself, and save local checkpoints'
    'require-increment:Show or set the increment nudge for code changes\: off | remind (recommend) | enforce (opt-in block)'
    'small-fix:Declare this session'\''s change too small for an increment (logged; satisfies require-increment)'
    'jev:Jev (System One)\: doctor | setup | ask | route | task | guard | screen | failure | browse | usage'
    'archive:Archive completed increments and sync living docs (project-specific folders)'
    'status:Show increment status overview (alias\: progress)'
    'update:Update SpecWeave\: CLI, instructions, config, AND plugins (default)'
    'sync:Sync increments with GitHub, Jira or Azure DevOps\: push | pull | status | setup'
    'doctor:Run comprehensive health check on SpecWeave project'
    'generate-rubric:Generate or refresh the AC-tied rubric.md quality contract at the increment root'
    'dashboard:Launch real-time observability dashboard in browser'
    'hooks:'
    'context:Show SpecWeave workspace context'
    'get:Clone and register an existing repository into the workspace'
)

_specweave() {
    local curcontext="$curcontext" state line

    _arguments -C '--workspace[Select the planning workspace explicitly]:workspace:_directories' '1: :->command' '*::arg:->args'

    case $state in
        command)
            _describe -t commands 'specweave commands' commands
            ;;
        args)
            case $line[1] in
                init)
                    _arguments \
                        '--name[Project name (alternative to positional argument)]' \
                        '--template[Project template (saas, api, fullstack)]' \
                        '--adapter[AI tool adapter (claude, cursor, copilot, generic)]' \
                        '--tech-stack[Technology stack (nodejs, python, etc.)]' \
                        '--language[Language for generated content (en, ru, es, zh, de, fr, ja, ko, pt)]' \
                        '--force[Force fresh start (non-interactive, removes existing .specweave)]' \
                        '--force-refresh[Force marketplace refresh (skip cache, always pull latest)]' \
                        '--git-hooks[Also install the SpecWeave pre-commit hook (off by default)]' \
                        '--full[Install all plugins (skip lazy loading, longer init but all skills available immediately)]' \
                        '--quick[Quick mode\: skip all prompts, use sensible defaults (local git, no external tools, minimal setup)]' \
                        '--non-interactive[Alias for --quick (skip all prompts)]' \
                        '--workspace[Select the planning workspace explicitly]' \
                        '--help[Show help]'
                    ;;
                uninstall)
                    _arguments \
                        '--global[Also clean global agent directories and plugin cache]' \
                        '--keep-data[Archive .specweave/ instead of deleting]' \
                        '--dry-run[Show what would be removed without deleting]' \
                        '--force[Skip confirmation prompt]' \
                        '--workspace[Select the planning workspace explicitly]' \
                        '--help[Show help]'
                    ;;
                pause)
                    _arguments \
                        '--reason[Reason for pausing]' \
                        '--force[Force pause (update reason if already paused)]' \
                        '--workspace[Select the planning workspace explicitly]' \
                        '--help[Show help]'
                    ;;
                start)
                    _arguments \
                        '--workspace[Select the planning workspace explicitly]' \
                        '--help[Show help]'
                    ;;
                resume)
                    _arguments \
                        '--workspace[Select the planning workspace explicitly]' \
                        '--help[Show help]'
                    ;;
                reopen)
                    _arguments \
                        '--reason[Why it is reopened (kept in metadata.reopened)]' \
                        '--json[Print the result as JSON]' \
                        '--workspace[Select the planning workspace explicitly]' \
                        '--help[Show help]'
                    ;;
                abandon)
                    _arguments \
                        '--reason[Reason for abandoning]' \
                        '--force[Force abandon (skip confirmation)]' \
                        '--workspace[Select the planning workspace explicitly]' \
                        '--help[Show help]'
                    ;;
                complete)
                    _arguments \
                        '--silent[Silent mode (for auto mode stop hook)]' \
                        '--yes[Assume yes (silent confirmation)]' \
                        '--skip-validation[Skip quality gate validation (DANGEROUS)]' \
                        '--reason[Close without a passing reports/verify.json (stored as metadata.closeReason)]' \
                        '--all[Close every active increment whose tasks are all done or skipped (requires --reason)]' \
                        '--workspace[Select the planning workspace explicitly]' \
                        '--help[Show help]'
                    ;;
                task)
                    _arguments \
                        '--force[Override a live claim, unmet deps or a Files overlap]' \
                        '--evidence[Evidence for `done` (commit sha, test output)]' \
                        '--run[Run <cmd> through the OS shell; exit 0 required, output stored as evidence]' \
                        '--note[Note (alias of --reason)]' \
                        '--reason[Reason (required for skip / block)]' \
                        '--all-mine[With `release`\: release every task claimed by this agent]' \
                        '--write[With `render`\: refresh a legacy tasks.md from the ledger]' \
                        '--line[Card text for claim/done/block (max 100 chars, longer text is truncated)]' \
                        '--link[Card link for claim/done/block (PR URL, report path, artifact URL)]' \
                        '--no-commit[Skip the git.autoCommitIncrement commit of the increment files]' \
                        '--json[Machine-readable output]' \
                        '--workspace[Select the planning workspace explicitly]' \
                        '--help[Show help]'
                    ;;
                ac)
                    _arguments \
                        '--check[With accept-skip\: the named check of the AC that is skipped (required)]' \
                        '--reason[With accept-skip\: why the check cannot be run, e.g. no license (required)]' \
                        '--accepted-by[With accept-skip\: the person who accepted the skip (required)]' \
                        '--authorization[With accept-skip\: their words, quoted, or a message/thread reference (required)]' \
                        '--accepted-at[With accept-skip\: when they accepted it, ISO-8601 (default\: now)]' \
                        '--uncovered[With accept-skip\: confirm skipping on an AC no task cites (it closes the whole AC)]' \
                        '--no-commit[Skip the git.autoCommitIncrement commit of the increment files]' \
                        '--json[Machine-readable output]' \
                        '--workspace[Select the planning workspace explicitly]' \
                        '--help[Show help]'
                    ;;
                card)
                    _arguments \
                        '--line[Card text (max 100 chars)]' \
                        '--link[Card link (PR URL, report path, artifact URL)]' \
                        '--evidence[Evidence for `done`]' \
                        '--run[With `done` on a T-NN card\: run <cmd>, exit 0 required]' \
                        '--reason[Why the card waits (`wait`)]' \
                        '--force[Override a live claim (T-NN cards)]' \
                        '--no-commit[Skip the git.autoCommitIncrement commit of the increment files (T-NN cards)]' \
                        '--json[Machine-readable output]' \
                        '--workspace[Select the planning workspace explicitly]' \
                        '--help[Show help]'
                    ;;
                cards)
                    _arguments \
                        '--md[Markdown checklist (the default output)]' \
                        '--json[Machine-readable output]' \
                        '--workspace[Select the planning workspace explicitly]' \
                        '--help[Show help]'
                    ;;
                verify)
                    _arguments \
                        '--cmd[Command to run (repeatable; overrides config/auto-detection)]' \
                        '--json[Print the verify report as JSON]' \
                        '--reason[Pass with no test commands configured; the reason is recorded in verify.json]' \
                        '--workspace[Select the planning workspace explicitly]' \
                        '--help[Show help]'
                    ;;
                review)
                    _arguments \
                        '--brief[Print the review brief only (paste it into any tool or model)]' \
                        '--reviewer[Reviewer to run\: codex, claude or one from review.reviewers (default\: auto)]' \
                        '--base[Diff base (default\: merge-base with origin/HEAD)]' \
                        '--timeout[Stop the reviewer after this many minutes (default 30)]' \
                        '--json[Print the result as JSON]' \
                        '--workspace[Select the planning workspace explicitly]' \
                        '--help[Show help]'
                    ;;
                skills)
                    _arguments \
                        '--json[Print as JSON]' \
                        '--workspace[Select the planning workspace explicitly]' \
                        '--help[Show help]'
                    ;;
                glossary)
                    _arguments \
                        '--strict[Exit 1 when anything is found (CI)]' \
                        '--json[Print findings as JSON]' \
                        '--workspace[Select the planning workspace explicitly]' \
                        '--help[Show help]'
                    ;;
                create-increment)
                    _arguments \
                        '--id[Increment ID (e.g., "0042-my-feature")]' \
                        '--auto-id[Auto-generate next available increment ID (default when --id is absent)]' \
                        '--name[Increment name suffix (defaults to a slug of the title)]' \
                        '--title[Feature title (defaults to the positional argument)]' \
                        '--description[Feature description (defaults to the title)]' \
                        '--project[Project ID (defaults to config project.name, else the folder name)]' \
                        '--board[Board ID for 2-level structures]' \
                        '--type[Increment type (feature, hotfix, bug, refactor, experiment)]' \
                        '--priority[Priority (P1, P2, P3)]' \
                        '--project-root[Override project root directory]' \
                        '--with-plan[Also scaffold plan.md (optional overflow; spec.md carries the Approach)]' \
                        '--planned[Create as "planned" instead of "active" (backlog work; start it with specweave start <id>)]' \
                        '--supersedes[Increment this one replaces (the old one is abandoned with a closeReason)]' \
                        '--parent[Parent increment (recorded as metadata.parent)]' \
                        '--no-commit[Skip the git.autoCommitIncrement commit of the new increment files]' \
                        '--json[Output result as JSON (for programmatic use)]' \
                        '--workspace[Select the planning workspace explicitly]' \
                        '--help[Show help]'
                    ;;
                handoff)
                    _arguments \
                        '--all[Write .specweave/handoffs/<date>-INDEX.md and index.json\: every active increment and every nested repo with local-only work (writes nothing else)]' \
                        '--dry-run[With --all\: print the index instead of writing it]' \
                        '--reason[Why you are handing off (e.g. "out of tokens")]' \
                        '--summary[Short summary of where things stand]' \
                        '--next[The exact next step for the resuming agent]' \
                        '--gotcha[A gotcha / warning for the next agent]' \
                        '--decision[A key decision (repeatable)]' \
                        '--inline[Embed the full scrubbed doc body in the paste-prompt (cross-machine resume)]' \
                        '--clipboard[Alias for --inline]' \
                        '--non-specweave[Force the .handoff/ fallback even inside a SpecWeave workspace]' \
                        '--out[Override the doc output path]' \
                        '--json[Output the full result as JSON (for programmatic use)]' \
                        '--no-push[Keep the handoff local (by default the branch and a snapshot of your edits are pushed so `specweave pickup` finds them anywhere)]' \
                        '--keep-claims[Keep your task claims instead of releasing them for the next agent]' \
                        '--no-commit[Skip the git.autoCommitIncrement commit of the increment files]' \
                        '--workspace[Select the planning workspace explicitly]' \
                        '--help[Show help]'
                    ;;
                pickup)
                    _arguments \
                        '--no-apply[Only show the waiting handoff; do not apply it to this checkout]' \
                        '--all[Print the newest handoff index (from `handoff --all`), actionable increments first; changes nothing]' \
                        '--list[Print the pending handoffs with their ids, newest first; changes nothing]' \
                        '--json[Output as JSON]' \
                        '--workspace[Select the planning workspace explicitly]' \
                        '--help[Show help]'
                    ;;
                report)
                    _arguments \
                        '--out[Where to write it (default\: the increment'\''s reports/handoff-report.html)]' \
                        '--workspace[Select the planning workspace explicitly]' \
                        '--help[Show help]'
                    ;;
                note)
                    _arguments \
                        '--workspace[Select the planning workspace explicitly]' \
                        '--help[Show help]'
                    ;;
                auto-handoff)
                    _arguments \
                        '--mode[suggest (default)\: tell you once at the threshold and keep working; enforce\: hand off and stop; checkpoint\: only save local checkpoints]' \
                        '--at[Threshold in percent of any usage window (default 95)]' \
                        '--wait-under[Do nothing at the threshold when the limit resets sooner than this (default 30; 0 turns it off)]' \
                        '--checkpoint-only[Same as --mode checkpoint]' \
                        '--handoff[Same as --mode enforce]' \
                        '--workspace[Select the planning workspace explicitly]' \
                        '--help[Show help]'
                    ;;
                require-increment)
                    _arguments \
                        '--workspace[Select the planning workspace explicitly]' \
                        '--help[Show help]'
                    ;;
                small-fix)
                    _arguments \
                        '--workspace[Select the planning workspace explicitly]' \
                        '--help[Show help]'
                    ;;
                jev)
                    _arguments \
                        '--json[Machine-readable JSON output]' \
                        '--provider[setup\: openrouter | typesafe | openai]' \
                        '--model[setup\: model id (defaults to the provider default)]' \
                        '--guard-bash[setup\: enable the opt-in PreToolUse Bash guard]' \
                        '--no-guard-bash[setup\: disable the Bash guard]' \
                        '--disable[setup\: turn Jev off for this project]' \
                        '--state[ask\: state as JSON, plain text, @file or - for stdin]' \
                        '--questions[ask\: questions as JSON or @file]' \
                        '--choice[ask\: shorthand for one choice question]' \
                        '--option[ask\: one --choice option (repeatable)]' \
                        '--noul[ask\: shorthand for one noul (true/false probability) question]' \
                        '--increment[task\: increment id (defaults to the active one)]' \
                        '--goal[browse\: what to accomplish]' \
                        '--url[browse\: starting URL]' \
                        '--allow-domain[browse\: allowed origin (repeatable)]' \
                        '--input[browse\: text the loop may type (repeatable)]' \
                        '--max-steps[browse\: step limit]' \
                        '--screenshot-dir[browse\: where to write screenshots]' \
                        '--allow-sensitive[browse\: allow clicking sensitive controls]' \
                        '--workspace[Select the planning workspace explicitly]' \
                        '--help[Show help]'
                    ;;
                archive)
                    _arguments \
                        '--keep-last[Keep last N increments, archive the rest]' \
                        '--last[STRICT\: Keep exactly last N increments by number, ignoring all protections]' \
                        '--older-than[Archive increments older than N days]' \
                        '--pattern[Archive increments matching pattern (regex)]' \
                        '--archive-completed[Archive all completed increments]' \
                        '--no-preserve-active[Allow archiving active/paused increments (dangerous!)]' \
                        '--external[Archive external living docs (FS-XXXE features imported from ADO/JIRA/GitHub)]' \
                        '--dry-run[Preview what would be archived without moving files]' \
                        '--workspace[Select the planning workspace explicitly]' \
                        '--help[Show help]'
                    ;;
                status)
                    _arguments \
                        '--verbose[Show detailed information]' \
                        '--type[Filter by increment type (feature, hotfix, bug, etc.)]' \
                        '--workspace[Select the planning workspace explicitly]' \
                        '--help[Show help]'
                    ;;
                update)
                    _arguments \
                        '--no-self[Skip CLI self-update via npm]' \
                        '--no-plugins[Skip marketplace plugins refresh]' \
                        '--all[Install ALL plugins (not just router)]' \
                        '--minimal[Clean /plugin output (removes marketplace, no lazy loading)]' \
                        '--check[Dry run - show what would change without making changes]' \
                        '--dry-run[Same as --check]' \
                        '--verbose[Show detailed output]' \
                        '--force[Force refresh even if up to date]' \
                        '--workspace[Select the planning workspace explicitly]' \
                        '--help[Show help]'
                    ;;
                sync)
                    _arguments \
                        '1:subcommand:(push pull status setup)' \
                        '--workspace[Select the planning workspace explicitly]' \
                        '--help[Show help]'
                    ;;
                doctor)
                    _arguments \
                        '--verbose[Show detailed output for each check]' \
                        '--json[Output as JSON]' \
                        '--quick[Skip slow checks (network, hook execution)]' \
                        '--skip-external[Skip external tool connectivity checks]' \
                        '--fix[Apply inline fixes (remove ghost files, stale cache, update lockfile hashes)]' \
                        '--fix-status[Fix metadata.json <-> spec.md status desyncs (formerly sw\:sync-status)]' \
                        '--workspace[Select the planning workspace explicitly]' \
                        '--help[Show help]'
                    ;;
                generate-rubric)
                    _arguments \
                        '--refresh[Regenerate from current ACs, overwriting an existing non-template rubric]' \
                        '--silent[Minimal output]' \
                        '--workspace[Select the planning workspace explicitly]' \
                        '--help[Show help]'
                    ;;
                dashboard)
                    _arguments \
                        '--port[Port number (default\: 3456)]' \
                        '--no-browser[Do not open browser automatically]' \
                        '--workspace[Select the planning workspace explicitly]' \
                        '--help[Show help]'
                    ;;
                hooks)
                    _arguments \
                        '1:subcommand:(log)' \
                        '--workspace[Select the planning workspace explicitly]' \
                        '--help[Show help]'
                    ;;
                context)
                    _arguments \
                        '1:subcommand:(projects)' \
                        '--workspace[Select the planning workspace explicitly]' \
                        '--help[Show help]'
                    ;;
                get)
                    _arguments \
                        '--dry-run[Preview adoption of an existing local checkout without writing]' \
                        '--json[Print the local adoption result as JSON]' \
                        '--expected-fingerprint[Apply only if the local adoption preview is unchanged]' \
                        '--branch[Clone a specific branch]' \
                        '--prefix[User story prefix (default\: first 3 chars uppercase)]' \
                        '--role[Repository role (frontend, backend, mobile, infra, shared)]' \
                        '--no-init[Skip specweave init on cloned repo]' \
                        '--yes[Skip confirmation prompts]' \
                        '--all[Clone all repositories in an org (source is org name)]' \
                        '--pattern[Filter repos by glob pattern, e.g. "service-*" (use with --all or org/* source)]' \
                        '--limit[Max repos to fetch in bulk mode (default\: 1000)]' \
                        '--no-archived[Skip archived repositories in bulk mode]' \
                        '--no-forks[Skip forked repositories in bulk mode]' \
                        '--workspace[Select the planning workspace explicitly]' \
                        '--help[Show help]'
                    ;;
            esac
            ;;
    esac
}

_specweave "$@"
